    {
      "parameters": {
        "jsCode": "// ============================================\n// DICCIONARIOS DE MAPEO ID → NOMBRE\n// ============================================\n\n// Mapeo de Pipelines\nconst pipelineMap = {\n  \"45415243\": \"LATAM Sales Pipeline\",\n};\n\n// Mapeo de Etapas (Stages)\nconst stageMap = {\n  // LATAM Sales Pipeline\n  \"93704483\": \"1. Target\",\n  \"93704485\": \"2. First Meeting\",\n  \"93704486\": \"3. Discovery\",\n  \"93704489\": \"4. Commercial Proposal\",\n  \"93720752\": \"5. Proposal Accepted\",\n  \"93720753\": \"6. Legal\",\n  \"93720754\": \"7. Won\",\n  \"93720756\": \"8. In Implementation\",\n  \"93720757\": \"9. Live\",\n  \"93720760\": \"Lost\",\n  \"96121413\": \"No Fit\",\n  \"93720761\": \"Icebox\",\n  \"94769845\": \"Long Term\"\n};\n\n// Si tienes propietarios, agrégalos aquí (opcional)\nconst ownerMap = {\n  // Ejemplo: descubre los IDs ejecutando el workflow y viendo qué IDs aparecen\n  \"123456789\": \"Fulano De Tal\",\n  \"987654321\": \"Pepito Perez\",\n  \"432198765\": \"John Doe\",\n  \"987612345\": \"Jane Doe\"\n};\n\n// ============================================\n// FUNCIÓN HELPER\n// ============================================\n\nconst getValue = (prop) => {\n  if (!prop) return '';\n  return prop.value !== undefined ? String(prop.value) : String(prop);\n};\n\n// ============================================\n// PROCESAMIENTO\n// ============================================\n\nconst items = $input.all();\n\nconst flattenedItems = items.map(item => {\n  const props = item.json.properties;\n  \n  // Extraer valores raw\n  const pipelineId = getValue(props.pipeline);\n  const stageId = getValue(props.dealstage);\n  const ownerId = getValue(props.hubspot_owner_id);\n  \n  // Mapear a nombres legibles\n  const pipelineName = pipelineMap[String(pipelineId)] || pipelineId;\n  const stageName = stageMap[String(stageId)] || stageId;\n  const ownerName = ownerMap[String(ownerId)] || ownerId;\n  \n  return {\n    json: {\n      'ID de registro': item.json.dealId || item.json.id || '',\n      'Nombre del negocio': getValue(props.dealname),\n      'Etapa del negocio': stageName,\n      'Fecha de Ganado ': getValue(props.fecha_de_ganado),\n      'Propietario del negocio': ownerName,\n      'Monthly Recurring Revenue (MRR)': getValue(props.revenue),\n      'Pipeline': pipelineName,\n      'Tipo de cliente': getValue(props.tipo_de_cliente),\n      'Fecha de creación': getValue(props.createdate),\n      'Valor': getValue(props.amount),\n      'Anual Recurring Revenue (ARR)': getValue(props.arr),\n      'Monthly Fee': getValue(props.pricing_fijo),\n      'Costo por Transacción ': getValue(props.pricing_variado),\n      'Origen de la oportunidad (Negocio)': getValue(props.origen_de_la_oportunidad__negocio_),\n      'Pais': getValue(props.pais),\n      'Monthly GMV': getValue(props.monthly_gmv),\n      'AOV': getValue(props.aov),\n      'FIT o NO FIT': getValue(props.fit_o_no_fit),\n      'Industria': getValue(props.industria),\n      'Motivo de perdido': getValue(props.motivo_de_perdido),\n      'SKU': getValue(props.sku),\n      'Ticket Promedio': getValue(props.ticket_promedio),\n      'Transacciones Mensuales.': getValue(props.transacciones_mensuales_),\n      'Última actividad': getValue(props.notes_last_updated),\n      'Motivo de no fit': getValue(props.motivo_de_no_fit),                \n    }\n  };\n});\n\nreturn flattenedItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -688,
        144
      ],
      "id": "29633452-f4ac-4e5c-ad28-869a29fd4dd1",
      "name": "Parsear datos"
    },
    {
      "parameters": {
        "jsCode": "// IDs de los pipelines permitidos\nconst allowedPipelines = [\n  \"45415243\", // LATAM Sales Pipeline\n];\n\n// IDs de las etapas permitidas por pipeline\nconst allowedStages = [\n  // LATAM Sales Pipeline\n  \"93704483\", // Target\n  \"93704485\", // First Meeting\n  \"93704486\", // Discovery\n  \"93704489\", // Commercial Proposal\n  \"93720752\", // Proposal Accepted\n  \"93720753\", // Legal\n  \"93720754\", // Won\n  \"93720756\", // In Implementation\n  \"93720757\", // Live\n  \"93720760\", // Lost\n  \"96121413\", // No Fit\n  \"93720761\", // Icebox\n  \"94769845\", // Long Term\n];\n\n// Obtener todos los items de entrada\nconst items = $input.all();\n\n// Filtrar solo los deals que cumplen las condiciones\nconst filteredItems = items.filter(item => {\n  const properties = item.json.properties;\n  \n  // Extraer valores como strings, manejando objetos o strings directos\n  const pipelineValue = typeof properties.pipeline === 'object' \n    ? properties.pipeline.value \n    : properties.pipeline;\n    \n  const stageValue = typeof properties.dealstage === 'object' \n    ? properties.dealstage.value \n    : properties.dealstage;\n  \n  // Convertir a string por si acaso\n  const pipelineStr = String(pipelineValue);\n  const stageStr = String(stageValue);\n  \n  const pipelineOk = allowedPipelines.includes(pipelineStr);\n  const stageOk = allowedStages.includes(stageStr);\n  \n  return pipelineOk && stageOk;\n});\n\n// Retornar items filtrados\nreturn filteredItems;"
      },

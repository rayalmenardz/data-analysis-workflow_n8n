    {
      "parameters": {
        "jsCode": "// Agrupamos todos los items en un solo array llamado 'data'\nconst allItems = $input.all().map(item => item.json);\n\nreturn {\n  json: {\n    data: allItems\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -512,
        144
      ],
      "id": "bb58f8de-f1d0-42d8-9e10-44f00be81371",
      "name": "Convertir datos en formato JSON"
    },
    {
      "parameters": {
        "jsCode": "// Mode: Run Once for All Items\nconst inputItems = $input.all();\nconst base64String = inputItems[0].json.binary.data; // Ruta simple definida en app.py\n\n// Decodificar Buffer\nconst buffer = Buffer.from(base64String, 'base64');\nlet csvText = buffer.toString('utf-8');\nif (csvText.charCodeAt(0) === 0xFEFF) csvText = csvText.slice(1);\n\n// Parsear CSV de salida\nconst lines = csvText.split(/\\r\\n|\\r|\\n/);\nconst headers = lines[0].split(',');\nconst result = [];\n\nfor (let i = 1; i < lines.length; i++) {\n    const line = lines[i];\n    if (line && line.trim().length > 0) {\n        const rowValues = line.split(',');\n        const obj = {};\n        for (let j = 0; j < headers.length; j++) {\n            const header = headers[j].trim().replace(/^\"|\"$/g, '');\n            let val = rowValues[j];\n            if (val) val = val.trim().replace(/^\"|\"$/g, '');\n            obj[header] = val || null;\n        }\n        result.push({ json: obj });\n    }\n}\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
